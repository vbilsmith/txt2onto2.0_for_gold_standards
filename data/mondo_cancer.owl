    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004023 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004023">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0040035"/>
        <rdfs:label>causal relationship with disease as subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004024 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004024">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0004023"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A relationship between a disease and a process where the disease process disrupts the execution of the process.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>RO:0004024</oboInOwl:hasDbXref>
        <oboInOwl:id>disease_disrupts</oboInOwl:id>
        <oboInOwl:shorthand>disease_disrupts</oboInOwl:shorthand>
        <rdfs:label>disease causes disruption of</rdfs:label>
        <rdfs:label>disease disrupts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004029 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004029">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0040035"/>
        <obo:IAO_0000115>A relationship between a disease and some feature of that disease, where the feature is either a phenotype or an isolated disease.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>RO:0004029</oboInOwl:hasDbXref>
        <oboInOwl:id>disease_has_feature</oboInOwl:id>
        <oboInOwl:shorthand>disease_has_feature</oboInOwl:shorthand>
        <rdfs:label>disease has feature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0040035 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0040035">
        <obo:IAO_0000115>This relation groups  relations between diseases and any other kind of entity.</obo:IAO_0000115>
        <rdfs:label>disease relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/mondo#disease_has_major_feature -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/mondo#disease_has_major_feature">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
        <oboInOwl:id>disease_has_major_feature</oboInOwl:id>
        <rdfs:label>disease has major feature</rdfs:label>
    </owl:ObjectProperty>
    


